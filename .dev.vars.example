# Local development secrets for wrangler
# Copy this to .dev.vars and fill in values.
# For production, set via `wrangler secret put <NAME>`.

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Base URL of the app — Better Auth uses this to build cookies/redirects
# and to validate the Origin header on mutating requests.
# `npm run dev` pins astro to port 4321.
AUTH_URL="http://localhost:4321"

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Search instance used by recipe search. The ai_search binding is always
# remote, so local dev must point at the dev instance, never production.
AI_SEARCH_INSTANCE="quickpantry-recipes-dev"

# Separate ingredient index for retrieval + Clef mapping. This binding is also
# remote. Configure/backfill the dev instance before enabling the fallback.
# An explicit Flagship ingredient-clef-mapping value overrides this fallback.
INGREDIENT_AI_SEARCH_INSTANCE="quickpantry-ingredients-dev"
INGREDIENT_CLEF_MAPPING_ENABLED="false"
