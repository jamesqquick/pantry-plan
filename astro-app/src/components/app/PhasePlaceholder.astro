---
interface Props {
  /** Page heading (eg. "Ingredients"). */
  heading: string;
  /** Phase label to surface what's coming (eg. "Phase 8"). */
  phase: string;
  /** Optional extra description below the heading. */
  description?: string;
}

const { heading, phase, description } = Astro.props;
---

<div class="space-y-6">
  <header class="space-y-1">
    <h1 class="text-3xl font-bold text-primary-on-background">{heading}</h1>
    {description && <p class="text-sm text-muted-foreground">{description}</p>}
  </header>

  <section class="rounded-lg border border-border bg-card p-6 space-y-3">
    <div class="inline-flex items-center rounded-input px-2 py-0.5 bg-primary-icon-bg text-primary-on-card text-xs font-medium">
      Coming in {phase}
    </div>
    <p class="text-sm text-muted-foreground">
      This page is a placeholder so the main nav doesn't dead-end while we
      migrate feature by feature. Real content lands when its phase ships.
    </p>
  </section>
</div>
