---
import { env } from "cloudflare:workers";
import { and, asc, eq } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import RecipeActions from "@/components/recipes/RecipeActions";
import { renderMarkdownToHtml } from "@/features/markdown/render-markdown";
import { formatQuantity } from "@/lib/quantity/quantity";
import { formatUnitForDisplay } from "@/lib/units";
import { UNIT_LABELS } from "@/lib/ingredients/units";
import {
  createDb,
  ingredient,
  recipe,
  recipeIngredient,
  recipeInstruction,
  recipeTag,
  tag,
} from "@/db";

export const prerender = false;

const user = Astro.locals.user!;
const { id } = Astro.params;
if (!id) return Astro.redirect("/recipes");

const db = createDb(env.DB);

const recipeRows = await db
  .select()
  .from(recipe)
  .where(and(eq(recipe.id, id), eq(recipe.userId, user.id)))
  .limit(1);

if (recipeRows.length === 0) {
  return new Response("Recipe not found", { status: 404 });
}
const r = recipeRows[0]!;

// Fire the three related queries in parallel.
const [ingredients, instructions, tags] = await Promise.all([
  db
    .select({
      id: recipeIngredient.id,
      quantity: recipeIngredient.quantity,
      unit: recipeIngredient.unit,
      displayText: recipeIngredient.displayText,
      rawText: recipeIngredient.rawText,
      sortOrder: recipeIngredient.sortOrder,
      ingredientId: recipeIngredient.ingredientId,
      ingredientName: ingredient.name,
    })
    .from(recipeIngredient)
    .leftJoin(ingredient, eq(recipeIngredient.ingredientId, ingredient.id))
    .where(eq(recipeIngredient.recipeId, id))
    .orderBy(asc(recipeIngredient.sortOrder)),
  db
    .select({
      id: recipeInstruction.id,
      sortOrder: recipeInstruction.sortOrder,
      text: recipeInstruction.text,
    })
    .from(recipeInstruction)
    .where(eq(recipeInstruction.recipeId, id))
    .orderBy(asc(recipeInstruction.sortOrder)),
  db
    .select({ id: tag.id, name: tag.name })
    .from(recipeTag)
    .innerJoin(tag, eq(recipeTag.tagId, tag.id))
    .where(eq(recipeTag.recipeId, id))
    .orderBy(asc(tag.name)),
]);

// Bump lastViewedAt in the background (non-blocking "best effort").
await db
  .update(recipe)
  .set({ lastViewedAt: new Date() })
  .where(eq(recipe.id, id));

// Render markdown notes server-side.
const notesHtml = r.notes?.trim()
  ? await renderMarkdownToHtml(r.notes)
  : null;

/** Format a single ingredient line from structured fields. */
function formatIngredientLine(i: (typeof ingredients)[number]): string {
  const parts: string[] = [];
  if (i.quantity != null && Number.isFinite(i.quantity)) {
    parts.push(formatQuantity(i.quantity));
  }
  const unitLabel = i.unit ? UNIT_LABELS[i.unit] : null;
  const unitDisplay = formatUnitForDisplay(unitLabel, i.quantity);
  if (unitDisplay) parts.push(unitDisplay);
  const name =
    (i.displayText?.trim() || i.ingredientName?.trim()) ?? "Unparsed ingredient";
  parts.push(name);
  return parts.join(" ");
}

const meta: { label: string; value: string }[] = [];
if (r.prepTimeMinutes != null) meta.push({ label: "Prep", value: `${r.prepTimeMinutes}m` });
if (r.cookTimeMinutes != null) meta.push({ label: "Cook", value: `${r.cookTimeMinutes}m` });
if (r.totalTimeMinutes != null) meta.push({ label: "Total", value: `${r.totalTimeMinutes}m` });
if (r.servings != null) meta.push({ label: "Servings", value: String(r.servings) });
---

<AppLayout title={`${r.title} — Pantry Plan`}>
  <article class="space-y-8">
    <nav class="text-sm">
      <a
        href="/recipes"
        class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        All recipes
      </a>
    </nav>

    <header class="flex flex-col gap-6 sm:flex-row sm:items-start">
      {r.imageUrl && (
        <img
          src={r.imageUrl}
          alt=""
          class="h-48 w-48 shrink-0 rounded-2xl object-cover"
          loading="lazy"
        />
      )}
      <div class="min-w-0 flex-1 space-y-3">
        <h1 class="font-display text-4xl leading-tight text-primary-on-background sm:text-5xl">
          {r.title}
        </h1>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((t) => (
              <span class="inline-flex items-center rounded-full bg-primary-icon-bg px-2.5 py-0.5 text-xs font-semibold text-primary-icon-fg">
                {t.name}
              </span>
            ))}
          </div>
        )}
        {meta.length > 0 && (
          <dl class="flex flex-wrap gap-x-6 gap-y-2 pt-1 text-sm">
            {meta.map((m) => (
              <div class="flex items-baseline gap-1.5">
                <dt class="text-muted-foreground">{m.label}</dt>
                <dd class="font-semibold tabular-nums">{m.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {r.sourceUrl && (
          <p class="text-sm">
            <a
              href={r.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-muted-foreground underline-offset-4 hover:text-primary-on-card hover:underline"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5"
                aria-hidden="true"
              >
                <path d="M15 3h6v6"></path>
                <path d="M10 14 21 3"></path>
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              </svg>
              View source
            </a>
          </p>
        )}
      </div>
      <RecipeActions client:load recipeId={r.id} />
    </header>

    <div class="grid gap-8 lg:grid-cols-5">
      <section class="lg:col-span-2">
        <h2 class="font-display text-2xl text-primary-on-background">Ingredients</h2>
        {ingredients.length === 0 ? (
          <p class="mt-3 text-sm text-muted-foreground">
            No ingredients yet. <a href={`/recipes/${r.id}/edit`} class="text-primary-on-card underline">Add some</a>.
          </p>
        ) : (
          <ul class="mt-4 space-y-1 text-sm">
            {ingredients.map((i) => (
              <li class="flex items-start gap-3 rounded-lg bg-panel px-3 py-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" aria-hidden="true"></span>
                <span class="leading-relaxed">{formatIngredientLine(i)}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="lg:col-span-3">
        <h2 class="font-display text-2xl text-primary-on-background">Instructions</h2>
        {instructions.length === 0 ? (
          <p class="mt-3 text-sm text-muted-foreground">
            No instructions yet. <a href={`/recipes/${r.id}/edit`} class="text-primary-on-card underline">Add some</a>.
          </p>
        ) : (
          <ol class="mt-4 space-y-4">
            {instructions.map((step, idx) => (
              <li class="flex gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-foreground tabular-nums">
                  {idx + 1}
                </span>
                <p class="whitespace-pre-wrap text-sm leading-relaxed pt-0.5">{step.text}</p>
              </li>
            ))}
          </ol>
        )}
      </section>
    </div>

    {notesHtml && (
      <section class="rounded-lg border border-border bg-card p-6">
        <h2 class="font-display text-2xl text-primary-on-background">Notes</h2>
        <div
          class="prose prose-sm mt-3 max-w-none text-card-foreground dark:prose-invert"
          set:html={notesHtml}
        />
      </section>
    )}
  </article>
</AppLayout>
