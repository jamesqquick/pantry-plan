---
import { env } from "cloudflare:workers";
import { count, eq } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import {
  createDb,
  recipe,
  ingredient,
  order as orderTable,
  tag,
} from "@/db";

export const prerender = false;

// Middleware guarantees user. Cast handled by AppLayout; here we assume non-null.
const user = Astro.locals.user!;
const db = createDb(env.DB);

const [[recipeCount], [ingredientCount], [orderCount], [tagCount]] =
  await Promise.all([
    db
      .select({ n: count(recipe.id) })
      .from(recipe)
      .where(eq(recipe.userId, user.id)),
    db
      .select({ n: count(ingredient.id) })
      .from(ingredient)
      .where(eq(ingredient.userId, user.id)),
    db
      .select({ n: count(orderTable.id) })
      .from(orderTable)
      .where(eq(orderTable.userId, user.id)),
    db.select({ n: count(tag.id) }).from(tag).where(eq(tag.userId, user.id)),
  ]);

const stats = [
  {
    label: "Recipes",
    value: recipeCount?.n ?? 0,
    href: "/recipes",
    // ChefHat
    icon: `<path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/>`,
  },
  {
    label: "Ingredients",
    value: ingredientCount?.n ?? 0,
    href: "/ingredients",
    // Wheat
    icon: `<path d="M2 22 16 8"/><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"/><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"/><path d="M11.47 17.47 13 19l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L5 19l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="M15.47 13.47 17 15l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L9 15l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/><path d="M19.47 9.47 21 11l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L13 11l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"/>`,
  },
  {
    label: "Orders",
    value: orderCount?.n ?? 0,
    href: "/orders",
    // ShoppingBasket
    icon: `<path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="M4.5 15.5h15"/><path d="m5 11 4-7"/><path d="m9 11 1 9"/>`,
  },
  {
    label: "Tags",
    value: tagCount?.n ?? 0,
    href: "/recipes",
    // Tag
    icon: `<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>`,
  },
];
---

<AppLayout title="Recipes — Pantry Plan">
  <div class="space-y-10">
    <header class="space-y-2">
      <h1 class="font-display text-4xl sm:text-5xl text-primary-on-background">
        Welcome back, {user.name}
      </h1>
      <p class="text-base text-muted-foreground">
        Let's get something delicious on the table.
        {
          user.role === "ADMIN" && (
            <span class="ml-1 inline-flex items-center rounded-input px-2 py-0.5 bg-primary-icon-bg text-primary-icon-fg text-xs font-semibold">
              ADMIN
            </span>
          )
        }
      </p>
    </header>

    <section class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        stats.map((s) => (
          <a href={s.href} class="stat-card group block p-5 cursor-pointer">
            <div class="flex items-start justify-between gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-icon-bg text-primary-icon-fg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-5 w-5"
                  aria-hidden="true"
                  set:html={s.icon}
                />
              </div>
            </div>
            <div class="mt-4 font-display text-4xl tabular-nums text-primary-on-background">
              {s.value}
            </div>
            <div class="mt-0.5 text-sm text-muted-foreground">{s.label}</div>
          </a>
        ))
      }
    </section>

    <section class="rounded-lg border border-border bg-card p-6 space-y-3">
      <h2 class="font-display text-2xl text-primary-on-background">
        More coming soon
      </h2>
      <p class="text-sm text-muted-foreground">
        Full recipe browsing, search, and tag filters land in Phase 6. Every
        card up there becomes a real page as its phase ships.
      </p>
    </section>
  </div>
</AppLayout>
