---
import { env } from "cloudflare:workers";
import { and, asc, eq, inArray } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import { GroceryListDisplay } from "@/components/orders/GroceryListDisplay";
import { DeleteOrderButton } from "@/components/orders/DeleteOrderButton";
import { renderMarkdownToHtml } from "@/features/markdown/render-markdown";
import { buildGroceryList, type GroceryListResult } from "@/lib/grocery/aggregate";
import {
  createDb,
  order,
  orderItem,
  recipe,
  recipeIngredient,
  ingredient,
} from "@/db";

export const prerender = false;

const user = Astro.locals.user!;
const { id } = Astro.params;
if (!id) return Astro.redirect("/orders");

const db = createDb(env.DB);

// Load order.
const orderRows = await db
  .select()
  .from(order)
  .where(and(eq(order.id, id), eq(order.userId, user.id)))
  .limit(1);

if (orderRows.length === 0) {
  return new Response("Order not found", { status: 404 });
}
const o = orderRows[0]!;

// Load order items with recipe titles.
const items = await db
  .select({
    id: orderItem.id,
    recipeId: orderItem.recipeId,
    batches: orderItem.batches,
    recipeTitle: recipe.title,
  })
  .from(orderItem)
  .innerJoin(recipe, eq(orderItem.recipeId, recipe.id))
  .where(eq(orderItem.orderId, id))
  .orderBy(asc(recipe.title));

// Load recipe ingredients with their ingredient data for grocery aggregation.
const recipeIds = [...new Set(items.map((i) => i.recipeId))];
let groceryResult: GroceryListResult = {
  totals: [],
  issues: { unmapped: [], missingQuantityOrUnit: [], cannotConvert: [], missingCost: [] },
  totalEstimatedCostCents: 0,
};

if (recipeIds.length > 0) {
  // Fetch all recipe ingredients for the relevant recipes with their ingredient data.
  const riRows = await db
    .select({
      riId: recipeIngredient.id,
      recipeId: recipeIngredient.recipeId,
      ingredientId: recipeIngredient.ingredientId,
      quantity: recipeIngredient.quantity,
      unit: recipeIngredient.unit,
      displayText: recipeIngredient.displayText,
      ingId: ingredient.id,
      ingName: ingredient.name,
      ingCostBasisUnit: ingredient.costBasisUnit,
      ingEstimatedCentsPerBasisUnit: ingredient.estimatedCentsPerBasisUnit,
      ingGramsPerCup: ingredient.gramsPerCup,
      ingCupsPerEach: ingredient.cupsPerEach,
      ingPreferredDisplayUnit: ingredient.preferredDisplayUnit,
    })
    .from(recipeIngredient)
    .leftJoin(ingredient, eq(recipeIngredient.ingredientId, ingredient.id))
    .where(inArray(recipeIngredient.recipeId, recipeIds))
    .orderBy(asc(recipeIngredient.sortOrder));

  // Group by recipe.
  const recipesForGrocery = new Map<string, {
    id: string;
    title: string;
    ingredients: Array<{
      id: string;
      ingredientId: string | null;
      ingredient?: {
        id: string;
        name: string;
        costBasisUnit: string;
        estimatedCentsPerBasisUnit: number | null;
        gramsPerCup: number | null;
        cupsPerEach: number | null;
        preferredDisplayUnit: string | null;
      } | null;
      quantity: number | null;
      unit: string | null;
      displayText: string;
    }>;
  }>();

  for (const item of items) {
    if (!recipesForGrocery.has(item.recipeId)) {
      recipesForGrocery.set(item.recipeId, {
        id: item.recipeId,
        title: item.recipeTitle,
        ingredients: [],
      });
    }
  }

  for (const ri of riRows) {
    const r = recipesForGrocery.get(ri.recipeId);
    if (!r) continue;
    r.ingredients.push({
      id: ri.riId,
      ingredientId: ri.ingredientId,
      ingredient: ri.ingId
        ? {
            id: ri.ingId,
            name: ri.ingName!,
            costBasisUnit: ri.ingCostBasisUnit!,
            estimatedCentsPerBasisUnit: ri.ingEstimatedCentsPerBasisUnit ?? null,
            gramsPerCup: ri.ingGramsPerCup ?? null,
            cupsPerEach: ri.ingCupsPerEach ?? null,
            preferredDisplayUnit: ri.ingPreferredDisplayUnit ?? null,
          }
        : null,
      quantity: ri.quantity,
      unit: ri.unit,
      displayText: ri.displayText ?? "",
    });
  }

  groceryResult = buildGroceryList({
    orderItems: items.map((i) => ({ recipeId: i.recipeId, batches: i.batches })),
    recipes: [...recipesForGrocery.values()] as any,
  });
}

// Render markdown notes.
const notesHtml = o.notes?.trim()
  ? await renderMarkdownToHtml(o.notes)
  : null;

const issueCount =
  groceryResult.issues.unmapped.length +
  groceryResult.issues.missingQuantityOrUnit.length +
  groceryResult.issues.cannotConvert.length +
  groceryResult.issues.missingCost.length;

function batchLabel(v: number): string {
  return v === 0.5 ? "½" : String(v);
}
---

<AppLayout title={`${o.name || "Order"} — Pantry Plan`}>
  <article class="space-y-8">
    <nav class="text-sm">
      <a
        href="/orders"
        class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
      >
        {/* Lucide ChevronLeft */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        All orders
      </a>
    </nav>

    <header class="space-y-4">
      <div class="flex items-start justify-between gap-4">
        <h1 class="font-display text-3xl leading-tight text-primary-on-background sm:text-4xl">
          {o.name || "Untitled order"}
        </h1>
        <a
          href={`/orders/${o.id}/edit`}
          class="btn-secondary shrink-0 gap-1.5"
        >
          {/* Lucide Pencil */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
          </svg>
          Edit
        </a>
      </div>
    </header>

    {/* Notes */}
    {notesHtml && (
      <section class="rounded-lg border border-border bg-card p-6">
        <div
          class="prose prose-sm max-w-none text-card-foreground dark:prose-invert"
          set:html={notesHtml}
        />
      </section>
    )}

    {/* Order items */}
    <section>
      <h2 class="font-display text-xl text-primary-on-background mb-4">
        Recipes
        <span class="ml-2 text-sm font-normal text-muted-foreground">
          ({items.length})
        </span>
      </h2>
      <ul class="divide-y divide-border rounded-lg border border-border bg-card">
        {items.map((item) => (
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <a
              href={`/recipes/${item.recipeId}`}
              class="min-w-0 truncate text-sm font-medium text-card-foreground hover:text-primary-on-card hover:underline cursor-pointer"
            >
              {item.recipeTitle}
            </a>
            <span class="shrink-0 rounded-full bg-panel px-2.5 py-0.5 text-xs font-medium tabular-nums text-muted-foreground">
              {batchLabel(item.batches)}×
            </span>
          </li>
        ))}
      </ul>
    </section>

    {/* Grocery list */}
    <section>
      <h2 class="font-display text-xl text-primary-on-background mb-4">
        Grocery list
        {groceryResult.totals.length > 0 && (
          <span class="ml-2 text-sm font-normal text-muted-foreground">
            ({groceryResult.totals.length} items)
          </span>
        )}
      </h2>
      <GroceryListDisplay client:load grocery={groceryResult} showCost={true} />
    </section>

    {/* Issues */}
    {issueCount > 0 && (
      <section class="rounded-lg border border-amber-200 bg-amber-50 p-6 dark:border-amber-800/30 dark:bg-amber-900/10">
        <h2 class="font-display text-lg text-amber-800 dark:text-amber-300 mb-3">
          Issues
          <span class="ml-2 text-sm font-normal">({issueCount})</span>
        </h2>
        <div class="space-y-3 text-sm text-amber-700 dark:text-amber-300/80">
          {groceryResult.issues.unmapped.length > 0 && (
            <div>
              <p class="font-medium">Unmapped ingredients ({groceryResult.issues.unmapped.length})</p>
              <ul class="mt-1 list-inside list-disc">
                {groceryResult.issues.unmapped.map((i) => (
                  <li>
                    <a href={`/recipes/${i.recipeId}`} class="underline underline-offset-2">{i.recipeTitle}</a>: {i.displayText}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {groceryResult.issues.missingQuantityOrUnit.length > 0 && (
            <div>
              <p class="font-medium">Missing quantity or unit ({groceryResult.issues.missingQuantityOrUnit.length})</p>
              <ul class="mt-1 list-inside list-disc">
                {groceryResult.issues.missingQuantityOrUnit.map((i) => (
                  <li>
                    <a href={`/recipes/${i.recipeId}`} class="underline underline-offset-2">{i.recipeTitle}</a>: {i.displayText}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {groceryResult.issues.cannotConvert.length > 0 && (
            <div>
              <p class="font-medium">Cannot convert units ({groceryResult.issues.cannotConvert.length})</p>
              <ul class="mt-1 list-inside list-disc">
                {groceryResult.issues.cannotConvert.map((i) => (
                  <li>
                    <a href={`/recipes/${i.recipeId}`} class="underline underline-offset-2">{i.recipeTitle}</a>: {i.displayText} — {i.reason}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {groceryResult.issues.missingCost.length > 0 && (
            <div>
              <p class="font-medium">Missing cost estimates ({groceryResult.issues.missingCost.length})</p>
              <ul class="mt-1 list-inside list-disc">
                {groceryResult.issues.missingCost.map((i) => (
                  <li>
                    <a href={`/ingredients/${i.ingredientId}`} class="underline underline-offset-2">{i.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {/* Delete */}
    <section class="pt-4 border-t border-border">
      <DeleteOrderButton
        client:load
        orderId={o.id}
        orderName={o.name ?? ""}
      />
    </section>
  </article>
</AppLayout>
