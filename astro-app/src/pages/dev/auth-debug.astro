---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { env } from "cloudflare:workers";
import { createDb, user, session, account } from "@/db";

export const prerender = false;

// Middleware enforces auth here. If we reach this page, locals.user is set.
const locals = Astro.locals;
const db = createDb(env.DB);

const [users, sessions, accounts] = await Promise.all([
  db.select().from(user),
  db.select().from(session),
  db
    .select({
      id: account.id,
      userId: account.userId,
      providerId: account.providerId,
      hasPassword: account.password,
    })
    .from(account),
]);
---

<BaseLayout title="Auth debug">
  <main class="min-h-screen bg-background text-foreground p-8 max-w-4xl mx-auto space-y-6">
    <header>
      <h1 class="text-3xl font-bold text-primary-on-background">Auth debug</h1>
      <p class="text-sm text-muted-foreground">
        Session state and Better Auth tables. Remove before production.
      </p>
    </header>

    <section class="rounded-lg border border-border bg-card p-6 space-y-3">
      <h2 class="text-xl font-semibold">Current session</h2>
      <pre class="text-xs bg-panel p-4 rounded overflow-auto"><code>{JSON.stringify({ user: locals.user, session: locals.session }, null, 2)}</code></pre>
    </section>

    <section class="rounded-lg border border-border bg-card p-6 space-y-3">
      <h2 class="text-xl font-semibold">user table ({users.length} rows)</h2>
      <pre class="text-xs bg-panel p-4 rounded overflow-auto"><code>{JSON.stringify(users, null, 2)}</code></pre>
    </section>

    <section class="rounded-lg border border-border bg-card p-6 space-y-3">
      <h2 class="text-xl font-semibold">session table ({sessions.length} rows)</h2>
      <pre class="text-xs bg-panel p-4 rounded overflow-auto"><code>{JSON.stringify(sessions, null, 2)}</code></pre>
    </section>

    <section class="rounded-lg border border-border bg-card p-6 space-y-3">
      <h2 class="text-xl font-semibold">account table ({accounts.length} rows)</h2>
      <p class="text-xs text-muted-foreground">Password hash is NOT shown — only whether it exists.</p>
      <pre class="text-xs bg-panel p-4 rounded overflow-auto"><code>{JSON.stringify(accounts.map(a => ({ ...a, hasPassword: !!a.hasPassword })), null, 2)}</code></pre>
    </section>
  </main>
</BaseLayout>
