---
import BaseLayout from "./BaseLayout.astro";
import { AppHeader } from "@/components/app/AppHeader";

interface Props {
  title?: string;
  description?: string;
  /** Optional narrower container for pages that need it. */
  containerClass?: string;
}

const {
  title,
  description,
  containerClass = "mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-10",
} = Astro.props;

// Middleware guarantees locals.user is set on protected routes, but be
// defensive in case a page forgets to opt into protection.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}
const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen supports-[height:100dvh]:min-h-dvh bg-background pt-[env(safe-area-inset-top)]">
    <AppHeader
      client:load
      userEmail={user.email}
      pathname={pathname}
    />
    <main
      id="main-content"
      class:list={[containerClass, "pb-[calc(5rem+env(safe-area-inset-bottom))]", "lg:pb-[calc(2rem+env(safe-area-inset-bottom))]"]}
    >
      <slot />
    </main>
  </div>
</BaseLayout>
