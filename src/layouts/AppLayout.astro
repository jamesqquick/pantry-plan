---
import BaseLayout from "./BaseLayout.astro";
import { AppHeader } from "@/components/app/AppHeader";

interface Props {
  title?: string;
  description?: string;
  /** Optional narrower container for pages that need it. */
  containerClass?: string;
}

const {
  title,
  description,
  containerClass = "mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-10",
} = Astro.props;

// Middleware guarantees locals.user is set on protected routes, but be
// defensive in case a page forgets to opt into protection.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}
const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-background">
    <AppHeader
      client:load
      userEmail={user.email}
      pathname={pathname}
    />
    <main id="main-content" class:list={[containerClass, "mobile-main-content"]}>
      <slot />
    </main>
  </div>
</BaseLayout>
