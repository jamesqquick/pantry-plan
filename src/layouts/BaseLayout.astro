---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  /** Pages whose top surface ignores dark mode (the landing page) pin the browser chrome color. */
  fixedThemeColor?: string;
}

const {
  title = "Quick Pantry",
  description = "Recipe management and meal planning",
  fixedThemeColor,
} = Astro.props;

// Matches --header-bg in each theme so the browser chrome blends into the header.
const THEME_COLOR_LIGHT = "#ffe28d";
const THEME_COLOR_DARK = "#33270c";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=3" />
    {
      fixedThemeColor ? (
        <meta name="theme-color" content={fixedThemeColor} data-fixed />
      ) : (
        <>
          <meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" data-light={THEME_COLOR_LIGHT} data-dark={THEME_COLOR_DARK} />
          <meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" data-light={THEME_COLOR_LIGHT} data-dark={THEME_COLOR_DARK} />
        </>
      )
    }
    <ClientRouter />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />
    <title>{title}</title>
    {/*
      Inline blocking theme bootstrap. Runs before paint to prevent FOUC.
      Mirrors the logic in src/lib/theme.ts (kept inline because is:inline
      scripts cannot import). If you change theme behavior, update both.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var explicit = stored === "light" || stored === "dark";
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var isDark = explicit ? stored === "dark" : prefersDark;
          var root = document.documentElement;
          if (isDark) root.classList.add("dark");
          else root.classList.remove("dark");
          var metas = document.querySelectorAll('meta[name="theme-color"]:not([data-fixed])');
          for (var i = 0; i < metas.length; i++) {
            var m = metas[i];
            m.setAttribute("content", explicit ? m.getAttribute(isDark ? "data-dark" : "data-light") : m.getAttribute(m.media.indexOf("dark") > -1 ? "data-dark" : "data-light"));
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function (error) {
            console.error("Quick Pantry service worker registration failed.", error);
          });
        });
      }
    </script>
  </head>
  <body class="min-h-screen supports-[height:100dvh]:min-h-dvh bg-background text-foreground antialiased">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />

    {/*
      Re-apply theme after every Astro view transition (the inline bootstrap
      above only runs on initial load). Also live-updates when the OS theme
      flips while the user is on "system".
    */}
    <script>
      import { applyTheme, getStoredTheme } from "@/lib/theme";

      // Reapply on every client-side navigation. Defensive: fixes any
      // desync between SSR and prerendered pages under view transitions.
      document.addEventListener("astro:after-swap", applyTheme);

      // Live OS theme updates — only when the user hasn't picked an override.
      const mql = window.matchMedia("(prefers-color-scheme: dark)");
      mql.addEventListener("change", () => {
        if (getStoredTheme() === "system") applyTheme();
      });
    </script>
  </body>
</html>
