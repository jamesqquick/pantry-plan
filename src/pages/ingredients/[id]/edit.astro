---
import { env } from "cloudflare:workers";
import { and, asc, eq, isNull, or } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import IngredientForm from "@/components/ingredients/IngredientForm";
import { createDb, ingredient, ingredientCategory } from "@/db";
import { centsToDollarsInput } from "@/lib/money";

export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = (user as any).role === "ADMIN";
const { id } = Astro.params;
if (!id) return Astro.redirect("/ingredients");

const db = createDb(env.DB);

// Load ingredient — must be visible to user.
const rows = await db
  .select()
  .from(ingredient)
  .where(
    and(
      eq(ingredient.id, id),
      or(isNull(ingredient.userId), eq(ingredient.userId, user.id))
    )
  )
  .limit(1);

if (rows.length === 0) {
  return new Response("Ingredient not found", { status: 404 });
}
const ing = rows[0]!;

// Permission check: owner can edit their own; admin can edit global.
const isGlobal = ing.userId === null;
const isOwner = ing.userId === user.id;
const canEdit = isOwner || (isGlobal && isAdmin);

if (!canEdit) {
  return Astro.redirect(`/ingredients/${id}`);
}

// Load categories in parallel.
const categories = await db
  .select({ name: ingredientCategory.name })
  .from(ingredientCategory)
  .orderBy(asc(ingredientCategory.name));

const categoryNames = categories.map((c) => c.name);

// Build initial form values.
const initialValues = {
  name: ing.name,
  category: ing.category ?? "",
  defaultUnit: ing.defaultUnit ?? "",
  costBasisUnit: ing.costBasisUnit ?? "G",
  estimatedCost: ing.estimatedCentsPerBasisUnit != null
    ? centsToDollarsInput(ing.estimatedCentsPerBasisUnit)
    : "",
  notes: ing.notes ?? "",
  preferredDisplayUnit: ing.preferredDisplayUnit ?? "AUTO",
  baseIngredientId: ing.baseIngredientId ?? "",
};

// Load base ingredient name for display.
let baseName: string | null = null;
if (ing.baseIngredientId) {
  const baseRows = await db
    .select({ name: ingredient.name })
    .from(ingredient)
    .where(eq(ingredient.id, ing.baseIngredientId))
    .limit(1);
  if (baseRows.length > 0) baseName = baseRows[0]!.name;
}
---

<AppLayout title={`Edit ${ing.name} — Quick Pantry`}>
  <div class="space-y-6">
    <nav class="text-sm">
      <a
        href={`/ingredients/${id}`}
        class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
      >
        {/* Lucide ChevronLeft */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to {ing.name}
      </a>
    </nav>

    <header class="space-y-2">
      <div class="flex items-center gap-3">
        <h1 class="font-display text-4xl text-foreground">
          Edit ingredient
        </h1>
        <span
          class:list={[
            "shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold",
            isGlobal
              ? "bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300"
              : "bg-purple-50 text-purple-700 dark:bg-purple-900/20 dark:text-purple-300",
          ]}
        >
          {isGlobal ? "Global" : "Custom"}
        </span>
      </div>
      {baseName && (
        <p class="text-sm text-muted-foreground">
          Based on{" "}
          <a
            href={`/ingredients/${ing.baseIngredientId}`}
            class="text-primary-on-card underline underline-offset-4 hover:text-primary-on-background"
          >
            {baseName}
          </a>
        </p>
      )}
    </header>

    <IngredientForm
      client:load
      mode="edit"
      ingredientId={id}
      categories={categoryNames}
      initialValues={initialValues}
    />
  </div>
</AppLayout>
