---
import { env } from "cloudflare:workers";
import { asc } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import IngredientForm from "@/components/ingredients/IngredientForm";
import { createDb, ingredientCategory } from "@/db";

export const prerender = false;

const db = createDb(env.DB);

const categories = await db
  .select({ name: ingredientCategory.name })
  .from(ingredientCategory)
  .orderBy(asc(ingredientCategory.name));

const categoryNames = categories.map((c) => c.name);
---

<AppLayout title="New ingredient — Pantry Plan">
  <div class="space-y-6">
    <nav class="text-sm">
      <a
        href="/ingredients"
        class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
      >
        {/* Lucide ChevronLeft */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        All ingredients
      </a>
    </nav>

    <header class="space-y-1">
      <h1 class="font-display text-4xl text-foreground">
        New ingredient
      </h1>
      <p class="text-sm text-muted-foreground">
        Create a custom ingredient for your recipes. Optionally start from a global catalog entry.
      </p>
    </header>

    <IngredientForm client:load mode="create" categories={categoryNames} />
  </div>
</AppLayout>
