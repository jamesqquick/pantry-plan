---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { MaterialForm } from "@/components/materials/MaterialForm";
export const prerender = false;
---
<AppLayout title="New material — Quick Pantry">
  <div class="space-y-8">
    <PageHeader>
      <a slot="eyebrow" href="/materials" class="mobile-action-control text-sm text-muted-foreground hover:text-foreground">← Materials</a>
      <div slot="content" class="space-y-3">
        <h1 class="font-display text-4xl tracking-tight sm:text-5xl">New material</h1>
        <p class="text-body text-muted-foreground">Enter what you buy, then choose how you'll measure what you use.</p>
      </div>
    </PageHeader>
    <MaterialForm client:load />
  </div>
</AppLayout>
