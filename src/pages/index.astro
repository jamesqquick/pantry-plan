---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = false;

// Authenticated users get bounced straight to the app.
if (Astro.locals.session) {
  return Astro.redirect("/recipes");
}
---

<BaseLayout title="Quick Pantry">
  <div class="landing-page">
    <header class="site-header page-shell">
      <a class="logo" href="/" aria-label="Quick Pantry home">Quick Pantry</a>
      <nav aria-label="Account navigation">
        <a class="nav-link" href="#how-it-works">How it works</a>
        <a class="nav-link" href="/login">Sign in</a>
        <a class="button button-small" href="/register">Get started</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero page-shell">
        <div class="hero-copy">
          <div class="eyebrow"><span aria-hidden="true"></span>Meet your new kitchen habit</div>
          <h1>Plan less.<span>Cook more.</span></h1>
          <p>Quick Pantry turns recipes you love into a flexible week and one smart shopping list.</p>
          <div class="hero-actions">
            <a class="button" href="/register">Create a free account</a>
            <a class="underlined-link" href="#how-it-works">Show me how</a>
          </div>
        </div>
        <div class="collage" aria-label="Quick Pantry preview">
          <div class="photo photo-main">
            <img src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85" alt="A vibrant bowl of roasted vegetables and greens">
          </div>
          <div class="sticky-note"><small>Tuesday dinner</small>Lemony greens + crispy chickpeas</div>
        </div>
      </section>

      <section class="how-it-works" id="how-it-works">
        <div class="page-shell">
          <div class="section-heading">
            <h2>Your food in one place.</h2>
            <p>Save the recipe when inspiration hits. Decide what to cook when you have a minute. Shop once with a list that has already done the math.</p>
          </div>
          <div class="steps">
            <article class="step"><b>1</b><h3>Toss in a recipe</h3><p>Paste a link or snap a cookbook page. We pull out the useful details and keep them tidy.</p><span>URL · Photo · Manual</span></article>
            <article class="step"><b>2</b><h3>Build your week</h3><p>Drag favorites into breakfast, lunch, and dinner. Change your mind whenever you want.</p></article>
            <article class="step"><b>3</b><h3>Grab one list</h3><p>Duplicates combine, units convert, and costs add up before you reach the store.</p></article>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Young+Serif&display=swap");

  :global(:root) {
    --landing-butter: oklch(92% 0.11 91);
    --landing-paper: oklch(98% 0.016 78);
    --landing-tomato: oklch(56% 0.19 35);
    --landing-ink: oklch(24% 0.045 38);
    --landing-olive: oklch(44% 0.08 115);
    --landing-line: oklch(74% 0.07 82);
  }

  .landing-page { background: var(--landing-butter); color: var(--landing-ink); min-height: 100vh; }
  .page-shell { margin-inline: auto; width: min(1200px, calc(100% - 2.75rem)); }
  .site-header { align-items: center; border-bottom: 1px solid var(--landing-line); display: flex; height: 5.375rem; justify-content: space-between; }
  .logo { color: var(--landing-tomato); flex-shrink: 0; font: 400 1.8rem/1 "Young Serif", Georgia, serif; letter-spacing: -0.04em; text-decoration: none; white-space: nowrap; }
  .site-header nav { align-items: center; display: flex; flex-shrink: 0; gap: 0.75rem; }
  .nav-link { color: var(--landing-ink); font: 600 0.875rem/1 "Figtree", sans-serif; padding: 0.75rem 0.9rem; text-decoration: none; white-space: nowrap; }
  .button { align-items: center; background: var(--landing-tomato); border: 0; border-radius: 999px; box-shadow: 0 4px 0 oklch(40% 0.15 35); color: var(--landing-paper); display: inline-flex; font: 700 0.875rem/1 "Figtree", sans-serif; justify-content: center; min-height: 2.9rem; padding: 0 1.4rem; text-decoration: none; transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 220ms cubic-bezier(0.22, 1, 0.36, 1); }
  .button:hover { box-shadow: 0 7px 0 oklch(40% 0.15 35); transform: translateY(-3px); }
  .button:active { box-shadow: 0 1px 0 oklch(40% 0.15 35); transform: translateY(3px); }
  .button-small { min-height: 2.9rem; }
  .hero { align-items: center; display: grid; gap: 3.125rem; grid-template-columns: 1.05fr 0.95fr; min-height: 43.1rem; padding-block: 3.875rem 4.7rem; position: relative; }
  .hero-copy { position: relative; z-index: 2; }
  .eyebrow { align-items: center; animation: pop-in 650ms both; color: var(--landing-olive); display: inline-flex; font: 700 0.75rem/1 "Figtree", sans-serif; gap: 0.5rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .eyebrow span { background: var(--landing-olive); border-radius: 999px; height: 0.55rem; width: 0.55rem; }
  .hero h1 { animation: pop-in 750ms 60ms both; color: var(--landing-ink); font: 400 clamp(3.75rem, 7.6vw, 6.75rem)/0.88 "Young Serif", Georgia, serif; letter-spacing: -0.055em; margin: 1.5rem 0; }
  .hero h1 span { color: var(--landing-tomato); display: block; transform: rotate(-2deg); transform-origin: left; }
  .hero-copy > p { animation: pop-in 750ms 140ms both; color: oklch(40% 0.05 52); font: 400 clamp(1.05rem, 1.5vw, 1.2rem)/1.6 "Figtree", sans-serif; max-width: 34rem; }
  .hero-actions { align-items: center; animation: pop-in 750ms 220ms both; display: flex; gap: 1.25rem; margin-top: 1.9rem; }
  .underlined-link { border-bottom: 2px solid var(--landing-ink); color: var(--landing-ink); font: 700 0.875rem/1 "Figtree", sans-serif; padding: 0.625rem 0.1rem; text-decoration: none; }
  .underlined-link:hover { color: var(--landing-tomato); }
  .collage { animation: pop-in 900ms 120ms both; height: 35rem; position: relative; }
  .photo { border: 7px solid var(--landing-paper); box-shadow: 0 15px 35px oklch(30% 0.08 60 / 0.18); overflow: hidden; position: absolute; transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
  .photo:hover { transform: rotate(0deg) scale(1.025); z-index: 2; }
  .photo img { display: block; height: 100%; object-fit: cover; transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1); width: 100%; }
  .photo:hover img { transform: scale(1.05); }
  .photo-main { height: 88%; right: 4%; top: 0.625rem; transform: rotate(2deg); width: 88%; }
  .sticky-note { background: var(--landing-paper); bottom: 0.5rem; box-shadow: 5px 7px 0 var(--landing-tomato); color: var(--landing-ink); font: 400 1rem/1.35 "Young Serif", Georgia, serif; padding: 1.1rem; position: absolute; right: -1rem; transform: rotate(4deg); width: 11rem; z-index: 2; }
  .sticky-note small { color: var(--landing-tomato); display: block; font: 700 0.625rem/1 "Figtree", sans-serif; letter-spacing: 0.08em; margin-bottom: 0.55rem; text-transform: uppercase; }
  .how-it-works { background: var(--landing-paper); padding: 4.7rem 0 5.4rem; position: relative; }
  .how-it-works::before { background: linear-gradient(135deg, transparent 8px, var(--landing-paper) 0) 0 0 / 16px 16px repeat-x; content: ""; height: 1.05rem; left: 0; position: absolute; right: 0; top: -1rem; }
  .section-heading { align-items: end; display: grid; gap: 4.4rem; grid-template-columns: 1fr 1fr; margin-bottom: 3rem; }
  .section-heading h2 { color: var(--landing-ink); font: 400 clamp(2.5rem, 5vw, 4.2rem)/0.95 "Young Serif", Georgia, serif; letter-spacing: -0.04em; margin: 0; }
  .section-heading p { color: oklch(44% 0.04 52); font: 400 1.05rem/1.6 "Figtree", sans-serif; margin: 0; }
  .steps { display: grid; gap: 1.4rem; grid-template-columns: repeat(3, 1fr); }
  .step { background: var(--landing-paper); border: 1.5px solid var(--landing-ink); border-radius: 1.1rem; min-height: 15rem; padding: 1.75rem 1.6rem 1.55rem; position: relative; transition: box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1), transform 350ms cubic-bezier(0.22, 1, 0.36, 1); }
  .step:nth-child(2) { transform: rotate(-1deg); }
  .step:nth-child(3) { transform: rotate(1deg); }
  .step:hover { box-shadow: 8px 8px 0 var(--landing-butter); transform: translateY(-7px) rotate(0); }
  .step b { align-items: center; background: var(--landing-tomato); border-radius: 999px; color: var(--landing-paper); display: grid; font: 700 0.8rem/1 "Figtree", sans-serif; height: 2.15rem; left: 1.4rem; place-items: center; position: absolute; top: -1.05rem; width: 2.15rem; }
  .step h3 { color: var(--landing-ink); font: 400 1.7rem/1 "Young Serif", Georgia, serif; margin: 1.25rem 0 0.6rem; }
  .step p { color: oklch(45% 0.04 52); font: 400 0.875rem/1.5 "Figtree", sans-serif; margin: 0; }
  .step span { color: var(--landing-olive); display: block; font: 700 0.7rem/1 "Figtree", sans-serif; letter-spacing: 0.08em; margin-top: 1.5rem; text-transform: uppercase; }
  @keyframes pop-in { from { opacity: 0; transform: translateY(1.1rem) rotate(-1deg); } to { opacity: 1; transform: none; } }
  @media (max-width: 56.25rem) { .hero { grid-template-columns: 1fr; } .hero-copy { text-align: center; } .hero-copy > p { margin-inline: auto; } .hero-actions { justify-content: center; } .collage { margin-inline: auto; max-width: 42.5rem; width: 100%; } .section-heading { gap: 1.1rem; grid-template-columns: 1fr; } }
  @media (max-width: 38.75rem) { .page-shell { width: calc(100% - 1.75rem); } .site-header { height: 4.6rem; } .logo { font-size: 1.45rem; } .nav-link:first-child { display: none; } .nav-link { padding-inline: 0.45rem; } .button-small { min-height: 2.6rem; padding-inline: 1rem; } .hero { min-height: 0; padding-block: 2.6rem 4.2rem; } .hero h1 { font-size: 3.65rem; } .hero-copy > p { font-size: 1.05rem; } .hero-actions { align-items: stretch; flex-direction: column; } .underlined-link { text-align: center; } .collage { height: 27rem; } .photo-main { height: 86%; right: 3%; width: 94%; } .sticky-note { bottom: 0.75rem; right: 0; width: 9.1rem; } .how-it-works { padding-block: 3.7rem 4.5rem; } .steps { gap: 2.1rem; grid-template-columns: 1fr; } .step:nth-child(n) { transform: none; } }
  @media (max-width: 21rem) { .nav-link { display: none; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; scroll-behavior: auto !important; transition: none !important; } }
</style>
