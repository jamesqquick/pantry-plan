---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { ResetPasswordForm } from "@/components/auth/ResetPasswordForm";

export const prerender = false;

const token = Astro.url.searchParams.get("token");
const invalidToken = Astro.url.searchParams.get("error") === "INVALID_TOKEN";
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<AuthLayout title="Reset password" heading="Choose a new password" subheading="Use a password you don’t use elsewhere.">
  {invalidToken || !token ? (
    <div class="space-y-4">
      <p role="alert" class="text-sm text-destructive">This reset link is invalid or expired.</p>
      <a href="/forgot-password" class="block text-center text-sm font-medium text-primary-on-card hover:underline">Request another link</a>
    </div>
  ) : (
    <ResetPasswordForm client:load token={token} />
  )}
</AuthLayout>
