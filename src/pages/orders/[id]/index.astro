---
import { env } from "cloudflare:workers";
import { and, asc, eq, inArray } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { GroceryListDisplay } from "@/components/orders/GroceryListDisplay";
import { DeleteOrderButton } from "@/components/orders/DeleteOrderButton";
import { OrderStatusSelect } from "@/components/orders/OrderStatusSelect";
import { formatDueDate, formatDueTime } from "@/components/orders/formatDue";
import { formatDollars } from "@/lib/money";
import { renderMarkdownToHtml } from "@/features/markdown/render-markdown";
import { buildGroceryList, type GroceryListResult } from "@/lib/grocery/aggregate";
import {
  createDb,
  order,
  orderItem,
  recipe,
  recipeIngredient,
  ingredient,
} from "@/db";

export const prerender = false;

const user = Astro.locals.user!;
const { id } = Astro.params;
if (!id) return Astro.redirect("/orders");

const db = createDb(env.DB);

// Load order.
const orderRows = await db
  .select()
  .from(order)
  .where(and(eq(order.id, id), eq(order.userId, user.id)))
  .limit(1);

if (orderRows.length === 0) {
  return new Response("Order not found", { status: 404 });
}
const o = orderRows[0]!;

// Load order items with recipe titles.
const items = await db
  .select({
    id: orderItem.id,
    recipeId: orderItem.recipeId,
    batches: orderItem.batches,
    recipeTitle: recipe.title,
  })
  .from(orderItem)
  .innerJoin(recipe, eq(orderItem.recipeId, recipe.id))
  .where(eq(orderItem.orderId, id))
  .orderBy(asc(recipe.title));

// Load recipe ingredients with their ingredient data for grocery aggregation.
const recipeIds = [...new Set(items.map((i) => i.recipeId))];
type GroceryRecipe = Parameters<typeof buildGroceryList>[0]["recipes"][number];
let groceryResult: GroceryListResult = {
  totals: [],
  issues: { unmapped: [], missingQuantityOrUnit: [], cannotConvert: [], missingCost: [] },
  totalEstimatedCostCents: null,
};

if (recipeIds.length > 0) {
  // Fetch all recipe ingredients for the relevant recipes with their ingredient data.
  const riRows = await db
    .select({
      riId: recipeIngredient.id,
      recipeId: recipeIngredient.recipeId,
      ingredientId: recipeIngredient.ingredientId,
      quantity: recipeIngredient.quantity,
      unit: recipeIngredient.unit,
      displayText: recipeIngredient.displayText,
      ingId: ingredient.id,
      ingName: ingredient.name,
      ingCostBasisUnit: ingredient.costBasisUnit,
      ingEstimatedCentsPerBasisUnit: ingredient.estimatedCentsPerBasisUnit,
      ingPurchasePriceCents: ingredient.purchasePriceCents,
      ingPurchaseQuantity: ingredient.purchaseQuantity,
      ingGramsPerCup: ingredient.gramsPerCup,
      ingGramsPerEach: ingredient.gramsPerEach,
      ingCupsPerEach: ingredient.cupsPerEach,
      ingPreferredDisplayUnit: ingredient.preferredDisplayUnit,
      ingPurchaseUnit: ingredient.purchaseUnit,
    })
    .from(recipeIngredient)
    .leftJoin(ingredient, eq(recipeIngredient.ingredientId, ingredient.id))
    .where(inArray(recipeIngredient.recipeId, recipeIds))
    .orderBy(asc(recipeIngredient.sortOrder));

  // Group by recipe.
  const recipesForGrocery = new Map<string, GroceryRecipe>();

  for (const item of items) {
    if (!recipesForGrocery.has(item.recipeId)) {
      recipesForGrocery.set(item.recipeId, {
        id: item.recipeId,
        title: item.recipeTitle,
        ingredients: [],
      });
    }
  }

  for (const ri of riRows) {
    const r = recipesForGrocery.get(ri.recipeId);
    if (!r) continue;
    r.ingredients.push({
      id: ri.riId,
      ingredientId: ri.ingredientId,
      ingredient: ri.ingId
        ? {
            id: ri.ingId,
            name: ri.ingName!,
            costBasisUnit: ri.ingCostBasisUnit!,
            estimatedCentsPerBasisUnit: ri.ingEstimatedCentsPerBasisUnit ?? null,
            purchasePriceCents: ri.ingPurchasePriceCents ?? null,
            purchaseQuantity: ri.ingPurchaseQuantity ?? null,
            gramsPerCup: ri.ingGramsPerCup ?? null,
            gramsPerEach: ri.ingGramsPerEach ?? null,
            cupsPerEach: ri.ingCupsPerEach ?? null,
            preferredDisplayUnit: ri.ingPreferredDisplayUnit ?? null,
            purchaseUnit: ri.ingPurchaseUnit ?? null,
          }
        : null,
      quantity: ri.quantity,
      unit: ri.unit,
      displayText: ri.displayText ?? "",
    });
  }

  groceryResult = buildGroceryList({
    orderItems: items.map((i) => ({ recipeId: i.recipeId, batches: i.batches })),
    recipes: [...recipesForGrocery.values()],
  });
}

// Render markdown notes.
const notesHtml = o.notes?.trim()
  ? await renderMarkdownToHtml(o.notes)
  : null;

function batchLabel(v: number): string {
  return v === 0.5 ? "½" : String(v);
}

const dueDateLabel = formatDueDate(o.dueDate);
const dueTimeLabel = formatDueTime(o.dueTime);
---

<AppLayout title={`${o.name || "Order"} — Quick Pantry`}>
  <article class="space-y-8">
    <PageHeader class="space-y-4">
      <nav slot="eyebrow" class="text-sm" aria-label="Breadcrumb">
        <a
          href="/orders"
          class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
        >
          {/* Lucide ChevronLeft */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          All orders
        </a>
      </nav>
      <h1 slot="content" class="break-words font-display text-3xl leading-tight text-foreground sm:text-4xl">
          {o.name || "Untitled order"}
      </h1>
      <a
          slot="actions"
          href={`/orders/${o.id}/edit`}
          class="btn-secondary shrink-0 gap-1.5"
        >
          {/* Lucide Pencil */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
          </svg>
          Edit
      </a>
    </PageHeader>

    <section class="grid gap-6 border-b border-border pb-7 md:grid-cols-4 md:items-start">
      <section aria-labelledby="order-customer-heading">
        <h2 id="order-customer-heading" class="font-display text-xl text-foreground">
          Customer
        </h2>
        {o.customerName ? (
          <p class="mt-2 text-sm font-medium text-foreground">{o.customerName}</p>
        ) : (
          <p class="mt-2 text-sm text-muted-foreground">Customer not added</p>
        )}
        {o.customerContact && (
          <p class="mt-1 break-all text-sm text-muted-foreground">{o.customerContact}</p>
        )}
      </section>

      <section aria-labelledby="order-fulfillment-heading">
        <h2 id="order-fulfillment-heading" class="font-display text-xl text-foreground">
          Fulfillment
        </h2>
        <p class="mt-2 text-sm font-medium text-foreground">
          {o.fulfillmentMethod === "DELIVERY" ? "Delivery" : "Pickup"}
        </p>
        {(dueDateLabel || dueTimeLabel) ? (
          <p class="mt-1 text-sm text-muted-foreground">
            {dueDateLabel ?? "Date not set"}{dueTimeLabel && ` at ${dueTimeLabel}`}
          </p>
        ) : (
          <p class="mt-1 text-sm text-muted-foreground">Due date not set</p>
        )}
        {o.fulfillmentMethod === "DELIVERY" && (
          <p class="mt-1 whitespace-pre-wrap break-words text-sm text-muted-foreground">
            {o.deliveryAddress || "Address not added"}
          </p>
        )}
      </section>

      <section aria-labelledby="order-total-heading">
        <h2 id="order-total-heading" class="font-display text-xl text-foreground">
          Order total
        </h2>
        <p class="mt-2 text-sm font-medium tabular-nums text-foreground">
          {o.totalCostCents != null ? formatDollars(o.totalCostCents) : "Not set"}
        </p>
      </section>

      <section aria-labelledby="order-status-heading">
        <h2 id="order-status-heading" class="font-display text-xl text-foreground">
          Order Status
        </h2>
        <div class="mt-2">
          <OrderStatusSelect
            client:load
            orderId={o.id}
            initialStatus={o.status}
          />
        </div>
      </section>
    </section>

    {/* Notes */}
    {notesHtml && (
      <section class="rounded-lg border border-border bg-card p-6">
        <div
          class="prose max-w-none text-card-foreground sm:prose-sm"
          set:html={notesHtml}
        />
      </section>
    )}

    {/* Order items */}
    <section>
      <h2 class="font-display text-xl text-foreground mb-4">
        Recipes
        <span class="ml-2 text-sm font-normal text-muted-foreground">
          ({items.length})
        </span>
      </h2>
      <ul class="divide-y divide-border rounded-lg border border-border bg-card">
        {items.map((item) => (
          <li class="flex items-center justify-between gap-4 px-4 py-3">
            <a
              href={`/recipes/${item.recipeId}`}
              class="min-w-0 truncate text-body font-medium text-card-foreground hover:text-primary-on-card hover:underline cursor-pointer"
            >
              {item.recipeTitle}
            </a>
            <span class="shrink-0 rounded-full bg-panel px-2.5 py-0.5 text-xs font-medium tabular-nums text-muted-foreground">
              {batchLabel(item.batches)}×
            </span>
          </li>
        ))}
      </ul>
    </section>

    {/* Grocery list */}
    <section>
      <h2 class="font-display text-xl text-foreground mb-4">
        Grocery list
        {groceryResult.totals.length > 0 && (
          <span class="ml-2 text-sm font-normal text-muted-foreground">
            ({groceryResult.totals.length} items)
          </span>
        )}
      </h2>
      <GroceryListDisplay client:load grocery={groceryResult} showCost={true} />
    </section>

    {/* Delete */}
    <section class="pt-4 border-t border-border">
      <DeleteOrderButton
        client:load
        orderId={o.id}
        orderName={o.name ?? ""}
      />
    </section>
  </article>
</AppLayout>
