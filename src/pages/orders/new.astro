---
import PageHeader from "@/components/ui/PageHeader.astro";
import { env } from "cloudflare:workers";
import { asc, eq } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import OrderForm from "@/components/orders/OrderForm";
import { createDb, recipe } from "@/db";
import { loadOwnedRecipeAvailability } from "@/lib/grocery/recipes";

export const prerender = false;

const user = Astro.locals.user!;
const db = createDb(env.DB);

const recipes = await db
  .select({ id: recipe.id, title: recipe.title })
  .from(recipe)
  .where(eq(recipe.userId, user.id))
  .orderBy(asc(recipe.title));
const availabilityByRecipe = await loadOwnedRecipeAvailability(db, user.id, recipes.map(({ id }) => id));
const recipeOptions = recipes.map((item) => ({
  ...item,
  availability: availabilityByRecipe[item.id] ?? { status: "unavailable" as const, notices: [] },
}));
---

<AppLayout title="New order — Quick Pantry">
  <div class="space-y-6">
    <PageHeader>
      <nav slot="eyebrow" class="text-sm" aria-label="Breadcrumb">
        <a
          href="/orders"
          class="inline-flex items-center gap-1 text-muted-foreground hover:text-foreground"
        >
          {/* Lucide ChevronLeft */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          All orders
        </a>
      </nav>
      <div slot="content" class="space-y-1">
        <h1 class="font-display text-4xl leading-[0.95] tracking-[-0.03em] text-foreground sm:text-5xl">
          New order
        </h1>
        <p class="text-body text-muted-foreground">
          Capture the customer request, due date, and pickup or delivery. Your grocery list uses the recipes and batch sizes below.
        </p>
      </div>
    </PageHeader>

    {recipes.length === 0 ? (
      <div class="rounded-lg border border-dashed border-border bg-card/50 p-8 text-center">
        <p class="text-body text-muted-foreground">
          You need at least one recipe before creating an order.
        </p>
        <a href="/recipes/new" class="btn-primary mt-4 inline-flex">
          Create a recipe
        </a>
      </div>
    ) : (
      <div class="space-y-4">
        <OrderForm client:load mode="create" recipeOptions={recipeOptions} />
      </div>
    )}
  </div>
</AppLayout>
