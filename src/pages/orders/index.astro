---
import { env } from "cloudflare:workers";
import { count, desc, eq } from "drizzle-orm";
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { createDb, order, orderItem } from "@/db";
import { OrderStatusBadge } from "@/components/orders/OrderStatusBadge";
import { formatDueDate, formatDueTime } from "@/components/orders/formatDue";

export const prerender = false;

const user = Astro.locals.user!;
const db = createDb(env.DB);

// Fetch all orders with item count.
const orders = await db
  .select({
    id: order.id,
    name: order.name,
    customerName: order.customerName,
    dueDate: order.dueDate,
    dueTime: order.dueTime,
    fulfillmentMethod: order.fulfillmentMethod,
    status: order.status,
    itemCount: count(orderItem.id),
  })
  .from(order)
  .leftJoin(orderItem, eq(orderItem.orderId, order.id))
  .where(eq(order.userId, user.id))
  .groupBy(order.id)
  .orderBy(desc(order.updatedAt));

---

<AppLayout title="Orders — Quick Pantry">
  <div class="space-y-8">
    <PageHeader>
      <div slot="content" class="space-y-3">
        <h1 class="font-display text-5xl leading-[0.95] tracking-[-0.04em] text-foreground sm:text-6xl">Orders</h1>
        <p class="text-base text-muted-foreground">
          {orders.length === 0
            ? "No orders yet. Create one to capture a customer's request and plan your batches."
            : `${orders.length} ${orders.length === 1 ? "order" : "orders"} in your kitchen.`}
        </p>
      </div>
      <a slot="actions" href="/orders/new" class="btn-primary shrink-0 gap-2">
        {/* Lucide Plus */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path d="M12 5v14"></path>
          <path d="M5 12h14"></path>
        </svg>
        New order
      </a>
    </PageHeader>

    {orders.length === 0 ? (
      <div class="rounded-lg border border-dashed border-border bg-card/50 p-12 text-center">
        <div class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full bg-primary-icon-bg text-primary-icon-fg">
          {/* Lucide ShoppingCart */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-7 w-7"
            aria-hidden="true"
          >
            <circle cx="8" cy="21" r="1"></circle>
            <circle cx="19" cy="21" r="1"></circle>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
          </svg>
        </div>
        <h2 class="font-display text-xl text-card-foreground">
          No orders yet
        </h2>
        <p class="mt-1 text-body text-muted-foreground">
          Record the customer request, choose recipes, and set batch sizes to build an order grocery list.
        </p>
      </div>
    ) : (
      <ul class="space-y-3">
        {orders.map((o) => (
          <li>
            <a
              href={`/orders/${o.id}`}
              class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 rounded-lg border border-border bg-card px-4 py-4 transition-colors hover:border-input hover:bg-primary/5 sm:grid-cols-[minmax(0,1.6fr)_minmax(140px,1fr)_minmax(80px,0.6fr)_auto_16px] sm:gap-5"
            >
              <div class="col-start-1 row-start-1 min-w-0 sm:col-start-1 sm:row-start-1">
                <p class="break-words font-medium text-card-foreground">
                  {o.name || "Untitled order"}
                </p>
                <p class="mt-1 break-words text-meta text-muted-foreground">
                  {o.customerName || "Customer not added"} · {o.itemCount} {o.itemCount === 1 ? "recipe" : "recipes"}
                </p>
              </div>
              <div class="col-start-1 row-start-2 text-sm text-muted-foreground sm:col-start-2 sm:row-start-1">
                <span class="font-medium text-foreground sm:hidden">Due </span>
                {formatDueDate(o.dueDate) ?? "No due date"}
                {formatDueTime(o.dueTime) && (
                  <span class="block text-xs sm:mt-1">{formatDueTime(o.dueTime)}</span>
                )}
              </div>
              <div class="col-start-2 row-start-2 text-right text-sm text-muted-foreground sm:col-start-3 sm:row-start-1 sm:text-left">
                <span class="sr-only sm:not-sr-only sm:mr-1">Fulfillment:</span>
                {o.fulfillmentMethod === "DELIVERY" ? "Delivery" : "Pickup"}
              </div>
              <OrderStatusBadge
                status={o.status}
                className="col-start-2 row-start-1 justify-self-end sm:col-start-4 sm:row-start-1"
              />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden h-4 w-4 shrink-0 text-muted-foreground sm:col-start-5 sm:row-start-1 sm:block"
                aria-hidden="true"
              >
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</AppLayout>
