---
import PageHeader from "@/components/ui/PageHeader.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { ProfileForm } from "@/components/profile/ProfileForm";
import { ChangePasswordForm } from "@/components/profile/ChangePasswordForm";
import { ConnectedAccounts } from "@/components/profile/ConnectedAccounts";
import { McpApiKeys } from "@/components/profile/McpApiKeys";
import { ChatgptConnection, ChatgptSetup } from "@/components/profile/ChatgptConnection";
import { env } from "cloudflare:workers";
import { createDb } from "@/db";
import { account, oauthClient } from "@/db/schema";
import { eq } from "drizzle-orm";
import { listMcpApiKeys } from "@/lib/mcp/api-keys";
import { getChatgptConnection } from "@/lib/oauth-connections";
import { CHATGPT_CLIENT_ID } from "@/lib/oauth-config";

export const prerender = false;

const user = Astro.locals.user!;
const db = createDb(env.DB);
const accounts = await db
  .select({ providerId: account.providerId })
  .from(account)
  .where(eq(account.userId, user.id));
const hasPassword = accounts.some((item) => item.providerId === "credential");
const hasGoogle = accounts.some((item) => item.providerId === "google");
const authError = Astro.url.searchParams.get("auth_error") ?? Astro.url.searchParams.get("error");
const apiKeys = await listMcpApiKeys(db, user.id);
const chatgptConnection = await getChatgptConnection(db, user.id);
const chatgptClient = user.role === "ADMIN" ? await db.query.oauthClient.findFirst({ where: eq(oauthClient.clientId, CHATGPT_CLIENT_ID) }) : null;
const chatgptRedirectUris: unknown = chatgptClient ? JSON.parse(chatgptClient.redirectUris) : [];
const chatgptRedirectUri = Array.isArray(chatgptRedirectUris) && typeof chatgptRedirectUris[0] === "string" ? chatgptRedirectUris[0] : "";
Astro.response.headers.set("Cache-Control", "no-store");
const serializedApiKeys = apiKeys.map((key) => ({
  ...key,
  createdAt: key.createdAt.toISOString(),
  lastUsedAt: key.lastUsedAt?.toISOString() ?? null,
}));
---

<AppLayout title="Profile — Quick Pantry">
  <PageHeader>
    <div slot="content" class="space-y-3">
      <h1 class="font-display text-5xl leading-[0.95] tracking-[-0.04em] text-foreground sm:text-6xl">Profile</h1>
      <p class="text-base text-muted-foreground">
        Manage your account details, password, and integrations.
      </p>
    </div>
  </PageHeader>
  <div class="mt-6 max-w-xl space-y-6">
    <ProfileForm
      client:load
      initialName={user.name}
      email={user.email}
      role={user.role ?? "USER"}
    />

    <ConnectedAccounts client:load hasPassword={hasPassword} hasGoogle={hasGoogle} />

    {authError && (
      <p role="alert" class="text-body text-destructive">
        Google could not be connected. Please try again.
      </p>
    )}

    {hasPassword && <ChangePasswordForm client:load />}
    <ChatgptConnection client:load initialConnection={chatgptConnection} />
    {user.role === "ADMIN" && <ChatgptSetup client:load initialRedirectUri={chatgptRedirectUri} />}

    <McpApiKeys
      client:load
      endpoint={`${Astro.url.origin}/mcp`}
      initialKeys={serializedApiKeys}
    />
  </div>
</AppLayout>
