---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header class:list={["flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between", className]}>
  <div class="min-w-0 flex-1">
    <slot name="content" />
  </div>
  <div class="flex w-full shrink-0 flex-wrap items-center gap-2 sm:w-auto sm:justify-end">
    <slot name="actions" />
  </div>
</header>
