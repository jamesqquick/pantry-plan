{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-plan",
  "account_id": "4426cbeacb457b1ca1b865d6c36ced0d",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "assets_navigation_has_no_effect"],
  "assets": {
    "binding": "ASSETS",
    // Astro Cloudflare adapter writes static client output to dist/client.
    // The server bundle in dist/server is referenced by `main` above.
    "directory": "./dist/client",
    // Serve dist/client/404.html (emitted by Astro) for unmatched routes
    // without invoking the Worker.
    "not_found_handling": "404-page"
    // No `run_worker_first`: let Cloudflare serve static assets directly so
    // `_astro/*` bundles, fonts, favicon, etc. don't bill as Worker
    // invocations or count against the daily request quota. The Worker is
    // invoked only when no asset matches (i.e., for SSR routes).
  },
  "observability": {
    "enabled": true
  },

  "vars": {
    // Public-ish config (not secrets). AUTH_URL must match the deployed origin.
    "AUTH_URL": "https://pantry-plan.jamesqquick.workers.dev"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-plan",
      "database_id": "c34f212d-1ce2-478a-9366-bb6f764d9f23",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "ratelimits": [
    {
      // AI parsing endpoints (recipe-from-image, recipe-from-URL).
      // 5 calls per 60s per user.id. Note: rate-limit counters are
      // per-Cloudflare-location, so the effective ceiling for a user
      // hitting multiple PoPs in a minute is somewhat higher.
      // Sized to allow normal recipe-import workflows while preventing
      // automated abuse / cost runaway on Workers AI.
      "name": "AI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "fd4d7b82-85af-49f7-ba1e-b5f535cc4bff"
    }
  ]
  // Secrets (set via `wrangler secret put`):
  // - AUTH_SECRET  (Better Auth JWT/cookie signing key)
}
